# Discord bot (Pterodactyl process) — never paste real values into Git or docs.
DISCORD_TOKEN=
GUILD_ID=
DEVELOPER_USER_ID=
# Only enable after supplying a suitable 16:9 server banner of at least 960x540.
APPLY_BANNER=false
# Public base URL of the website. Used by setup for the verification link, by
# greetings, and by the delivery worker. Required for website-only verification.
WEBSITE_URL=http://127.0.0.1:3000

# --- Website (Vercel or local preview) ---
# Website Discord OAuth (exact HTTPS callback for this deployment).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/api/discord/callback
# Comma-separated Discord user IDs allowed to access /admin.
DISCORD_ADMIN_USER_IDS=
# Optional override. By default, the website uses the Verified Member role saved by bot setup.
DISCORD_VERIFIED_ROLE_ID=
# Optional. Staff-only audit channel for website sign-in embeds. Default: the
# 🔐│verification channel saved by bot setup. Must be a text channel in the guild.
DISCORD_VERIFICATION_LOG_CHANNEL_ID=
# Optional. Bumps the rules version members must accept before signing in.
RULES_VERSION=1
# Required on a website host that does not share the bot's setup data.
DISCORD_TRADE_FEED_CHANNEL_ID=
DISCORD_TRADE_RADAR_ROLE_ID=
# Optional shared internal secret that lets the Pterodactyl bot worker drive delivery retries.
INTERNAL_WORKER_SECRET=
# Public base URL of the website for the bot's delivery worker. Only required when INTERNAL_WORKER_SECRET is set.
TRADE_HUB_URL=
# Vercel production website only. Keep real values out of Git.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CRON_SECRET=
