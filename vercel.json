{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run web:build:vercel",
  "outputDirectory": "website/dist",
  "functions": { "api/marketplace.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/marketplace?__route=:path*" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/trade/:id", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/feed-retry", "schedule": "13 2 * * *" },
    { "path": "/api/delivery-retry", "schedule": "41 2,8,14,20 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    }
  ]
}
